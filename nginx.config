server {
    listen 80;
    server_name local.api.chatapp.co;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name local.api.chatapp.co;

    ssl_certificate /etc/nginx/certs/fullchain.pem;  # Path to your SSL certificate
    ssl_certificate_key /etc/nginx/certs/privkey.pem;  # Path to your SSL certificate key

    location / {
        proxy_pass http://chatappapi:${APP_PORT};  # Forward requests to the chatappapi service
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}