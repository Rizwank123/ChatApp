# Local development only. Copy to .env and replace every sample secret before deployment.
APP_NAME=chatapp
APP_ENV=development
APP_PORT=7700

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chatapp
DB_PASSWORD=root
DB_DATABASE_NAME=chatapp
DB_SSL_MODE=disable
DB_SSL_ROOT_CERT=
DB_BIND_ADDRESS=127.0.0.1

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1

AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_EXPIRY_PERIOD=24
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

STORAGE_PROVIDER=minio
# The local Compose object store exposes an S3 API. This endpoint must be reachable by
# both the API container and the device opening presigned upload/download URLs.
# Set it to your LAN IP or DNS name when testing from a physical phone, and set
# S3_BIND_ADDRESS=0.0.0.0 so Docker publishes the endpoint on the LAN interface.
MINIO_ENDPOINT=host.docker.internal:8333
MINIO_ACCESS_KEY=localdev
MINIO_SECRET_KEY=local-dev-secret-change-me
MINIO_BUCKET=chatapp-media
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=
S3_PORT=8333
S3_BIND_ADDRESS=127.0.0.1

API_BIND_ADDRESS=127.0.0.1
