{
  "expo": {
    "name": "Vibely",
    "slug": "vibely",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vibely",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatapp.vibely",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.chatapp.vibely",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vibely to access photos you choose to share.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
